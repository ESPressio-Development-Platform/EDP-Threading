      "version": "https://github.com/ESPressio-Development-Platform/EDP-Platform.git#main",
      "platforms": "*"
    },
    {
      "name": "EDP-Clock",
      "version": "https://github.com/ESPressio-Development-Platform/EDP-Clock.git#main",
      "platforms": "*"
